{
  "manifest_version": 3,
  "name": "VideoSpeed",
  "version": "0.6.10",
  "minimum_chrome_version": "120",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VideoSpeed",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "default_locale": "en"
}
