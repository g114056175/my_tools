<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>VoiceCaptureLite</AssemblyName>
    <RootNamespace>VoiceCaptureLite</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Capture.ico</ApplicationIcon>
    <Version>2.2.1</Version>
    <SatelliteResourceLanguages>zh-Hant</SatelliteResourceLanguages>
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' != 'true'">8.0.25</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/Capture.ico" /></ItemGroup>
</Project>
