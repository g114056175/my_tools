<Window x:Class="VoiceCaptureLite.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:VoiceCaptureLite.Controls"
 Title="聲音擷取" Width="960" Height="560" MinWidth="720" MinHeight="500" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" PreviewKeyDown="OnKeyDown">
 <Grid Margin="20,18,20,12" Background="{StaticResource Bg}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="150"/><RowDefinition x:Name="PlaybackRow" Height="Auto" MinHeight="48"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="SourceRow" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="來源" Margin="0,0,10,0" Foreground="{StaticResource Muted}"/>
   <ComboBox x:Name="SourceCombo" Grid.Column="1" SelectionChanged="SourceChanged" AutomationProperties.Name="錄製來源"><ComboBoxItem Content="系統音訊 · 預設播放裝置"/><ComboBoxItem x:Name="ProcessSourceItem" Content="指定視窗的音訊"/></ComboBox>
   <TextBlock Grid.Column="2" Text="視窗" Margin="16,0,10,0" Foreground="{StaticResource Muted}"/>
   <ComboBox x:Name="WindowCombo" Grid.Column="3" DisplayMemberPath="DisplayName" AutomationProperties.Name="選擇視窗" ToolTip="同一程序的多個視窗可能共用音訊"/>
   <Button x:Name="RefreshButton" Grid.Column="4" Content="↻  重新整理" Margin="10,0,0,0" Click="RefreshWindows"/>
  </Grid>
  <TextBlock x:Name="SystemSourceDescription" Visibility="Collapsed" Margin="0,4,0,18" Text="錄製預設耳機／喇叭播放的所有聲音 · 不含麥克風" Foreground="{StaticResource Muted}" ToolTip="錄製開始時的 Windows 預設播放裝置。其他輸出裝置不會混入；此系統不支援依程序選取來源。若開啟麥克風監聽，送到播放裝置的監聽聲也會被錄下。"/>
  <Grid Grid.Row="1" Margin="0,0,0,16">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="RecordButton" Content="●  開始錄製" Background="#23835D" BorderBrush="#46BA8D" Click="RecordClicked" MinWidth="126"/>
    <Button x:Name="PauseRecordButton" Content="Ⅱ  暫停錄製" Margin="8,0,18,0" Click="PauseRecordClicked"/>
    <TextBlock x:Name="RecordingTimeText" Text="00:00.00" FontFamily="Consolas" FontSize="17"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="ImportButton" Content="匯入音檔" Click="ImportClicked" ToolTip="開啟 MP3 / WAV；也可拖放檔案或 Ctrl+V 貼上檔案"/>
    <Button x:Name="DeleteButton" Content="清除" Margin="8,0,0,0" Click="DeleteClicked" ToolTip="只清除工作音檔，不會刪除匯入的原檔"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" CornerRadius="12" BorderBrush="#24435B" BorderThickness="1" Padding="12,10" Background="#0A192B">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8"><TextBlock x:Name="WaveMeta" Text="拖入 MP3 / WAV，或開始錄製" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,270,0"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="FitButton" Content="全部" Padding="10,4" Click="FitClicked"/>
      <Button x:Name="SuggestedButton" Content="建議 · 30 秒" Padding="10,4" Margin="6,0,0,0" Click="SuggestedClicked" ToolTip="以目前播放位置為起點，顯示約 30 秒；短音檔完整顯示"/>
      <TextBlock x:Name="ViewSpanText" Text="" Width="86" TextAlignment="Right" Foreground="{StaticResource Muted}"/>
     </StackPanel>
    </Grid>
    <c:WaveformControl x:Name="Waveform" Grid.Row="1" MinHeight="90" ToolTip="點擊波形跳轉，不會自動播放。按住底部時間刻度：向右拖增加可見秒數，向左拖減少；最小 5 秒，最大全長。雙擊刻度還原全部；Ctrl+滾輪也可縮放。"/>
    <c:TimelineNavigator x:Name="Navigator" Grid.Row="2" Height="26" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.Name="可見時間範圍" ToolTip="拖曳中央移動時間範圍；拉伸左右邊緣縮放；點擊空白處直接跳到該位置。也可在波形內 Ctrl+滾輪縮放。"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3" Margin="0,10,0,0">
   <Grid>
    <StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="▶  播放" Click="PlayClicked" MinWidth="100"/>
     <Button x:Name="TrimButton" Content="裁切" Margin="8,0,0,0" Click="TrimClicked"/>
     <Button x:Name="CancelTrimButton" Content="取消裁切" Margin="8,0,0,0" Click="CancelTrimClicked" Visibility="Collapsed"/>
     <Button x:Name="ConfirmTrimButton" Content="確定裁切" Margin="8,0,0,0" Click="ConfirmTrimClicked" Background="#18567C" Visibility="Collapsed"/>
    </StackPanel>
    <TextBlock x:Name="PlaybackTimeText" Text="00:00.00 / 00:00.00" HorizontalAlignment="Right" FontFamily="Consolas" Foreground="{StaticResource Muted}"/>
   </Grid>
   <StackPanel x:Name="TrimDetails" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0">
    <TextBlock Text="開始（秒）" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/><TextBox x:Name="TrimStartBox" Width="85" LostKeyboardFocus="TrimTimeEdited" KeyDown="TrimTimeKey" AutomationProperties.Name="裁切開始秒數"/>
    <TextBlock Text="結束（秒）" Foreground="{StaticResource Muted}" Margin="16,0,6,0"/><TextBox x:Name="TrimEndBox" Width="85" LostKeyboardFocus="TrimTimeEdited" KeyDown="TrimTimeKey" AutomationProperties.Name="裁切結束秒數"/>
    <TextBlock x:Name="SelectionText" Margin="18,0,0,0" Foreground="#7DD3FC"/>
   </StackPanel>
  </StackPanel>
  <Grid Grid.Row="4" Margin="0,18,0,10">
   <StackPanel Orientation="Horizontal"><TextBlock Text="輸出" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
    <ComboBox x:Name="FormatCombo" Width="92" SelectedIndex="0" SelectionChanged="FormatChanged" AutomationProperties.Name="輸出格式">
     <ComboBoxItem Content="WAV"/><ComboBoxItem Content="MP3"/>
    </ComboBox>
    <TextBlock Text="音質" Foreground="{StaticResource Muted}" Margin="14,0,8,0"/>
    <Grid Width="145">
     <ComboBox x:Name="QualityCombo" SelectedIndex="1" SelectionChanged="FormatChanged" AutomationProperties.Name="MP3 音質" Visibility="Collapsed"><ComboBoxItem Content="標準 · 128 kbps"/><ComboBoxItem Content="中 · 192 kbps"/><ComboBoxItem Content="高 · 320 kbps"/></ComboBox>
     <TextBlock x:Name="WavQualityText" Text="PCM 16-bit · 不壓縮" Foreground="{StaticResource Muted}" ToolTip="保留工作音檔的 PCM 資料，不額外做有損編碼；提高位元數不會補回來源細節。"/>
    </Grid><TextBlock x:Name="SizeText" Margin="12,0,0,0" Foreground="{StaticResource Muted}"/>
   </StackPanel>
   <Button x:Name="ExportButton" Content="匯出音檔  ↗" Background="#18567C" BorderBrush="#3286B5" HorizontalAlignment="Right" Click="ExportClicked"/>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="5" Text="就緒" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
 </Grid>
</Window>
