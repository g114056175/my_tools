{
  "name": "video-speed",
  "version": "0.6.19",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser/release-check.mjs",
    "test:activity": "node tests/browser/activity-check.mjs",
    "test:stability": "node tests/browser/stability-check.mjs",
    "test:language": "node tests/browser/language-check.mjs",
    "test:autostart": "node tests/browser/autostart-check.mjs",
    "test:routes": "node --test tests/browser/page-bridge-route-check.mjs",
    "test:soak": "node tests/browser/long-playback-soak.mjs",
    "test:notices": "node tests/browser/initial-rate-notice-check.mjs",
    "test:popup": "node tests/browser/popup-target-check.mjs",
    "test:targets": "node tests/browser/visual-target-check.mjs",
    "test:lifecycle": "node tests/browser/idle-lifecycle-check.mjs candidate",
    "test:loading": "node tests/browser/slow-load-check.mjs candidate",
    "test:network-loading": "node tests/browser/network-load-check.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "sharp": "0.35.5",
    "tldts": "7.4.19"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/g114056175/my_tools.git",
    "directory": "VideoSpeed"
  }
}
